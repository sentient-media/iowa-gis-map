{
  "name": "iowa-cafo-map",
  "version": "1.0.0",
  "description": "Sentient Media \u2014 Iowa CAFO map viewer (embeddable)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "data": "node scripts/process-data.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run data && node --test tests/data.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^7.0.2",
    "postcss": "^8.4.49",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0"
  }
}
